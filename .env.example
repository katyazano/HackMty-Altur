# ==============================================================================
# Altur Voice Anti-Spoofing API Environment Variables
# ==============================================================================

# Server configuration
HOST=0.0.0.0
PORT=8080
ENVIRONMENT=production

# Audio & Decision Parameters
CALIBRATED_THRESHOLD=0.9623
TARGET_SAMPLE_RATE=16000
TELEPHONY_SAMPLE_RATE=8000
MAX_AUDIO_SIZE_MB=15

# AWS S3 Audit Configuration (Optional)
ENABLE_S3_AUDIT=false
AWS_REGION=us-east-1
S3_AUDIT_BUCKET=antispoofing-audio-audit-altur
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
